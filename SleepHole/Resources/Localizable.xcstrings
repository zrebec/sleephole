          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hotová noc %@–%@ 🪙, bez pauzy +%lld, každá pokojná hodina +%lld. V meste pribúdajú obyvatelia a vyššie budovy."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hotová noc vynese %@–%@ 🪙, bez pauzy +%lld, každá klidná hodina +%lld. Ve městě přibývají obyvatelé a vyšší budovy."
          }
        }
      }
    },
    "A finished night: %@ 🪙 (level 1), %@ (2), %@ (3), %@ (4). Unfinished: half.": {
