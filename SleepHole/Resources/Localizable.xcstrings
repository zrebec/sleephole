    "Parcels 1–3 of a month cost 20%% of your coins, parcels 4–6 cost 40%%, parcels 7–9 cost 60%% – never less than %lld 🪙. At most nine a month.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcels 1–3 of a month cost 20%% of your coins, parcels 4–6 cost 40%%, parcels 7–9 cost 60%% – never less than %lld 🪙. At most nine a month."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Balíčky 1–3 v mesiaci stoja 20 %% tvojich mincí, balíčky 4–6 stoja 40 %%, balíčky 7–9 stoja 60 %% – nikdy menej ako %lld 🪙. Najviac deväť za mesiac."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Balíčky 1–3 v měsíci stojí 20 %% tvých mincí, balíčky 4–6 stojí 40 %%, balíčky 7–9 stojí 60 %% – nikdy méně než %lld 🪙. Nejvýše devět za měsíc."
          }
        }
      }
    },
    "Buy this parcel?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
