          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Putovanie na celú noc: večer pri chate, dielňa, zdvihne sa vietor, búrka a úkryt v jaskyni, podzemné jazero a ticho po daždi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
