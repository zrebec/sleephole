    "“Dawn chorus”, “Singing bowl”, “Music box” (“Klosterglocken” by Louis Lefébure-Wély, public domain) and “Kalimba” are CC0 recordings from Freesound.org.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Dawn chorus”, “Singing bowl”, “Music box” (“Klosterglocken” by Louis Lefébure-Wély, public domain) and “Kalimba” are CC0 recordings from Freesound.org."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "„Ranné vtáctvo“, „Spievajúca miska“, „Hracia skrinka“ („Klosterglocken“ od Louisa Lefébure-Wélyho, voľné dielo) a „Kalimba“ sú CC0 nahrávky z Freesound.org."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„Ranní ptáci“, „Zpívající mísa“, „Hrací skříňka“ („Klosterglocken“ od Louise Lefébure-Wélyho, volné dílo) a „Kalimba“ jsou CC0 nahrávky z Freesound.org."
          }
        }
      }
