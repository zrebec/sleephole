        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Múzeum má nový obraz: mačka spí na obláčiku. Ktovie, kto im bol modelom 🐾"
          }
        }
      }
    },
    "From the top of our tallest building you can see the whole town.": {
      "localizations": {
