          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapni test a vyskúšaj: zamknúť telefón, odomknúť, prepnúť do inej appky, stiahnuť Control Center, otvoriť kameru zo zamknutej obrazovky, nechať sa zavolať. Nakoniec pošli záznam cez „Zdieľať“."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapni test a zkus: zamknout telefon, odemknout, přepnout do jiné appky, stáhnout Ovládací centrum, otevřít Fotoaparát ze zamčené obrazovky, nechat si zavolat. Nakonec pošli záznam přes „Sdílet“."
