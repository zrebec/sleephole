          "stringUnit": {
            "state": "translated",
            "value": "A comfy bed"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pohodlná posteľ"
          }
        }
      }
    },
    "A comfortable mattress and pillow make your bedroom a nicer place to sleep.": {
