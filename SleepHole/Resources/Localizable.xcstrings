        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phone face down"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mobil displejom nadol"
          }
        }
      }
    },
    "Turn your phone face down, so its glow doesn't reach you at night.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn your phone face down, so its glow doesn't reach you at night."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otoč mobil displejom nadol, nech ťa v noci neruší jeho svetlo."
          }
        }
      }
    },
    "The 20-minute rule": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The 20-minute rule"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pravidlo 20 minút"
          }
        }
      }
    },
    "Still awake after about 20 minutes? Get up and do something calm, like reading a book, then come back when sleep returns.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still awake after about 20 minutes? Get up and do something calm, like reading a book, then come back when sleep returns."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stále hore po zhruba 20 minútach? Vstaň, rob niečo pokojné, napríklad čítaj, a vráť sa, keď sa spánok vráti."
          }
        }
      }
    },
    "Sleep helps you learn": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep helps you learn"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Spánok pomáha učeniu"
          }
        }
      }
    },
    "While you sleep, your brain stores memories – good sleep helps learning and clear thinking.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While you sleep, your brain stores memories – good sleep helps learning and clear thinking."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Počas spánku sa upevňujú spomienky – dobrý spánok pomáha učeniu aj jasnému mysleniu."
          }
        }
      }
    },
    "Naps before 3 p.m.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Naps before 3 p.m."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Šlofík do tretej"
          }
        }
      }
    },
    "Try to finish any nap before 3 p.m., so the evening can get properly sleepy.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try to finish any nap before 3 p.m., so the evening can get properly sleepy."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Šlofík si dopraj radšej pred 15:00, aby večer prišla poriadna ospalosť."
          }
        }
      }
    },
    "Keep the light low": {
      "localizations": {
