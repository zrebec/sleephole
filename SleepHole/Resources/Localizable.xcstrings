    "You can change your schedule. The first change opens a change week (7 days); after it your schedule stays the same for a month.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change your schedule. The first change opens a change week (7 days); after it your schedule stays the same for a month."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozvrh môžeš zmeniť. Prvá zmena otvorí týždeň na zmeny (7 dní), potom ostane rozvrh mesiac rovnaký."
          }
        }
      }
    },
    "🔧 Change week: %@ left (until %@). Change it as often as you like.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "🔧 Change week: %@ left (until %@). Change it as often as you like."
