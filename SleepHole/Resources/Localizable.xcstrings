          }
        }
      }
    },
    "You can fix a typo for free for 10 minutes after renaming.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can fix a typo for free for 10 minutes after renaming."
          }
