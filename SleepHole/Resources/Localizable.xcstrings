    },
    "A complete afternoon nap.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A complete afternoon nap."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hotový popoludňajší odpočinok."
          }
        }
      }
    },
    "A complete night = %lld 🪙, and more for higher levels (L2 %lld, L3 %lld, L4 %lld 🪙); unfinished = half. Every %lldth complete night in a row adds a +%lld 🪙 bonus.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A complete night = %lld 🪙, and more for higher levels (L2 %lld, L3 %lld, L4 %lld 🪙); unfinished = half. Every %lldth complete night in a row adds a +%lld 🪙 bonus."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hotová noc = %1$lld 🪙 a vyššie levely viac (L2 %2$lld, L3 %3$lld, L4 %4$lld 🪙); rozostavaná = polovica. Každá %5$lld. hotová noc v rade pridá bonus +%6$lld 🪙."
          }
        }
      }
    },
    "A crackling camp fire, crickets and a brook; someone chops wood, the dog potters about, the chickens settle down, an owl calls. A different story every night.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A crackling camp fire, crickets and a brook; someone chops wood, the dog potters about, the chickens settle down, an owl calls. A different story every night."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Praská táborák, svrčky a potôčik; niekto štiepa drevo, pes sa motá okolo, sliepky sa ukladajú, zahúka sova. Každú noc iný príbeh."
          }
        }
      }
    },
    "A gentle kalimba melody.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A gentle kalimba melody."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemná melódia na kalimbe."
          }
        }
      }
    },
    "A good night rebuilt a ruin.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
