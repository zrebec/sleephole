        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když jsi během přípravy v jiné appce, %@ před jejím koncem přijde upozornění."
          }
        }
      }
    },
    "It protects %@ from %@. It costs nothing and does not use up this month's own joker.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It protects %@ from %@. It costs nothing and does not use up this month's own joker."
          }
