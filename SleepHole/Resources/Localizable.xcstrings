        }
      }
    },
    "After the start there's time for a podcast or story: %@ from bedtime, or from the start if you start later. In another app? I'll call you %@ before the end.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After the start there's time for a podcast or story: %@ from bedtime, or from the start if you start later. In another app? I'll call you %@ before the end."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Po štarte máš čas na podcast či rozprávku: %@ od večierky, alebo od štartu, ak začneš neskôr. Ak budeš v inej appke, %@ pred koncom ťa zavolám."
          }
        }
      }
    },
    "All rules": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All rules"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetky pravidlá"
          }
        }
      }
    },
    "An early start works up to %@ before bedtime: the night counts in full and the alarm rings as always.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An early start works up to %@ before bedtime: the night counts in full and the alarm rings as always."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skorší štart ide až %@ pred večierkou: noc sa počíta celá a budík zazvoní ako vždy."
          }
        }
      }
    },
    "At night I guard the building": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At night I guard the building"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V noci strážim stavbu"
          }
        }
      }
    },
    "Bedtime and wake-up are the same every day.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedtime and wake-up are the same every day."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Večierka a budíček platia každý deň rovnako."
          }
        }
      }
    },
    "Bronze: %@, free once a month; it is also used by itself on the first missed night.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bronze: %@, free once a month; it is also used by itself on the first missed night."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bronzový: %@, raz za mesiac zadarmo; použije sa aj sám pri prvej vynechanej noci."
          }
        }
      }
    },
    "Closing the app (swiping it away) counts as leaving.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing the app (swiping it away) counts as leaving."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatvorenie appky (potiahnutím nahor) sa počíta ako odchod."
          }
        }
      }
    },
    "Coins and town": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coins and town"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mince a mesto"
          }
        }
      }
    },
    "Confirm you're up by shaking the phone or entering the code, from %@ before the alarm.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm you're up by shaking the phone or entering the code, from %@ before the alarm."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vstávanie potvrdíš zatrasením alebo kódom, najskôr %@ pred budíkom."
          }
        }
      }
    },
    "Evening": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Evening"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Večer"
          }
        }
      }
    },
    "Every building has residents and the town grows with them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every building has residents and the town grows with them."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá budova má obyvateľov a mesto podľa nich rastie."
          }
        }
      }
    },
    "Every night builds something": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every night builds something"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá noc postaví budovu"
          }
        }
      }
    },
    "Hi, I'm your cat! In the evening we start a building, at night your phone rests, and in the morning it's finished.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi, I'm your cat! In the evening we start a building, at night your phone rests, and in the morning it's finished."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahoj, som tvoja mačka! Večer spolu začneme stavbu, v noci necháš telefón oddychovať a ráno z toho bude budova."
          }
        }
      }
    },
    "How SleepHole works": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How SleepHole works"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako funguje SleepHole"
          }
        }
      }
    },
    "If you leave the app, a warning comes within seconds and you have %@ to come back. All trips together may last %@ a night.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you leave the app, a warning comes within seconds and you have %@ to come back. All trips together may last %@ a night."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď appku opustíš, o pár sekúnd príde upozornenie a na návrat máš %@. Všetky odchody spolu môžu za noc trvať %@."
          }
        }
      }
    },
    "If you unlock the phone and use it outside the app for more than %@, we'll remind you gently.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you unlock the phone and use it outside the app for more than %@, we'll remind you gently."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď telefón odomkneš a používaš ho mimo appky dlhšie ako %@, jemne ti to pripomenieme."
          }
        }
      }
    },
    "If you're in another app during the setup, a notice comes %@ before it ends.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you're in another app during the setup, a notice comes %@ before it ends."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak si počas prípravy v inej appke, %@ pred jej koncom príde upozornenie."
          }
        }
      }
    },
    "Jokers": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokers"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Žolíky"
          }
        }
      }
    },
    "Keep SleepHole open and lock your phone. If you leave, you have %@ to come back. Phone calls don't count.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep SleepHole open and lock your phone. If you leave, you have %@ to come back. Phone calls don't count."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechaj SleepHole otvorený a zamkni telefón. Keď odídeš, na návrat máš %@. Telefonát sa nepočíta."
          }
        }
      }
    },
    "Levels: nights 1–%lld level 1, %lld–%lld up to level 2, %lld–%lld up to level 3, from night %lld up to level 4.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Levels: nights 1–%lld level 1, %lld–%lld up to level 2, %lld–%lld up to level 3, from night %lld up to level 4."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Úrovne: noci 1–%lld úroveň 1, %lld–%lld do úrovne 2, %lld–%lld do úrovne 3, od %lld. noci do úrovne 4."
          }
        }
      }
    },
    "Lucky night ×2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lucky night ×2"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Šťastná noc ×2"
          }
        }
      }
    },
    "No pause +%lld, every calm hour +%lld, every %lldth finished night in a row +%lld.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No pause +%lld, every calm hour +%lld, every %lldth finished night in a row +%lld."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez pauzy +%lld, každá pokojná hodina +%lld, každá %lld. hotová noc v rade +%lld."
          }
        }
      }
    },
    "No worries – a joker protects your streak and the next good night repairs a ruin. Keep your phone on the charger overnight.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No worries – a joker protects your streak and the next good night repairs a ruin. Keep your phone on the charger overnight."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič sa nedeje – žolík ochráni sériu a ďalšia dobrá noc ruinu opraví. Telefón nechaj cez noc na nabíjačke."
          }
        }
      }
    },
    "On iOS 26, pulling down Notification Center counts as leaving the app – use 🌙 Pause to read a message.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On iOS 26, pulling down Notification Center counts as leaving the app – use 🌙 Pause to read a message."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stiahnuté Centrum hlásení sa na iOS 26 počíta ako odchod z appky – na prečítanie správy použi 🌙 Pauzu."
          }
        }
      }
    },
    "Pause": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauza"
          }
        }
      }
    },
    "Pick your bedtime and wake-up. The first %@ are a change week – try as much as you like. Then it stays for a month.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick your bedtime and wake-up. The first %@ are a change week – try as much as you like. Then it stays for a month."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber si večierku a budíček. Prvých %@ je týždeň na zmeny – skúšaj, koľko chceš. Potom rozvrh mesiac platí."
          }
        }
      }
    },
    "Privacy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Súkromie"
          }
        }
      }
    },
    "Renaming the town: the first name is free, a typo fix within %@, once a year free, otherwise %@ 🪙.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renaming the town: the first name is free, a typo fix within %@, once a year free, otherwise %@ 🪙."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Premenovanie mesta: prvé zadarmo, oprava preklepu do %@, raz za rok zadarmo, inak %@ 🪙."
          }
        }
      }
    },
    "Rewards": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rewards"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odmeny"
          }
        }
      }
    },
    "Shake your phone or enter your code – from %@ before the alarm. Within %@ after it, the building is done!": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shake your phone or enter your code – from %@ before the alarm. Within %@ after it, the building is done!"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatras telefónom alebo zadaj kód – už %@ pred budíkom. Do %@ po budíku je stavba hotová!"
          }
        }
      }
    },
    "Silver: %@ for %@ 🪙. Gold: %@ for %@ 🪙. Each kind once a month.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Silver: %@ for %@ 🪙. Gold: %@ for %@ 🪙. Each kind once a month."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Strieborný: %@ za %@ 🪙. Zlatý: %@ za %@ 🪙. Každý druh raz za mesiac."
          }
        }
      }
    },
    "SleepHole stays open; you can turn the screen off and lock the phone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SleepHole stays open; you can turn the screen off and lock the phone."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "SleepHole ostáva otvorený; obrazovku môžeš vypnúť a telefón zamknúť."
          }
        }
      }
    },
    "Strict mode (Settings, off by default): a system-alarm warning, and using the phone brings the building down.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strict mode (Settings, off by default): a system-alarm warning, and using the phone brings the building down."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prísny režim (Nastavenia, predvolene vypnutý): výstraha systémovým budíkom a pri použití telefónu stavba spadne."
          }
        }
      }
    },
    "Tap “Go to sleep” from %@ before bedtime until %@ after it. Tired sooner? You can start up to %@ early.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap “Go to sleep” from %@ before bedtime until %@ after it. Tired sooner? You can start up to %@ early."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťukni na „Ísť spať“ od %@ pred večierkou do %@ po nej. Keď ťa premáha únava, ide to aj %@ skôr."
          }
        }
      }
    },
    "The alarm rings for %@, also in silent mode; if you allow the system alarm, it rings as a backup.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The alarm rings for %@, also in silent mode; if you allow the system alarm, it rings as a backup."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Budík zvoní %@, aj v tichom režime; ak povolíš systémový budík, zazvoní ako záloha."
          }
        }
      }
    },
    "The app only reads Apple Health. iCloud carries your town only between your own devices.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app only reads Apple Health. iCloud carries your town only between your own devices."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Zdravie appka len číta. iCloud prenáša tvoje mesto len medzi tvojimi zariadeniami."
          }
        }
      }
    },
    "The reminder, the nap window, sounds and the code can change any time.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reminder, the nap window, sounds and the code can change any time."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripomienku, okno odpočinku, zvuky a kód môžeš meniť kedykoľvek."
          }
        }
      }
    },
    "The setup lasts your setup time (%lld, %lld or %lld minutes in Settings) from bedtime, or from the start if you start later; %@ from an early start.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The setup lasts your setup time (%lld, %lld or %lld minutes in Settings) from bedtime, or from the start if you start later; %@ from an early start."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Príprava trvá zvolený čas (%lld, %lld alebo %lld minút v Nastaveniach) od večierky, alebo od štartu, ak začneš neskôr; pri skoršom štarte %@ od štartu."
          }
        }
      }
    },
    "Tips": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tips"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipy"
          }
        }
      }
    },
    "Want to read a message? Tap 🌙 Pause – %@ outside the app, the first one each night is free.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Want to read a message? Tap 🌙 Pause – %@ outside the app, the first one each night is free."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Chceš si prečítať správu? Ťukni na 🌙 Pauza – %@ mimo appky, prvá za noc je zadarmo."
          }
        }
      }
    },
    "We collect nothing about you. Only the chosen city's location goes to the weather service.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We collect nothing about you. Only the chosen city's location goes to the weather service."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "O tebe nič nezbierame. Službe počasia ide len poloha zvoleného mesta."
          }
        }
      }
    },
    "When a night goes wrong": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a night goes wrong"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď sa noc nevydarí"
          }
        }
      }
    },
    "When you need a moment": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you need a moment"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď potrebuješ chvíľu"
          }
        }
      }
    },
    "Within %@ after the alarm: a finished building. Within %@: unfinished. Later: ruins.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Within %@ after the alarm: a finished building. Within %@: unfinished. Later: ruins."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Do %@ po budíku: hotová budova. Do %@: rozostavaná. Neskôr: ruina."
          }
        }
      }
    },
    "Without a passcode the phone can't tell locking from leaving, so trips aren't counted there (closing the app still is).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without a passcode the phone can't tell locking from leaving, so trips aren't counted there (closing the app still is)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefón bez kódu zámku nevie rozlíšiť zamknutie od odchodu, preto tam appka odchody nepočíta (okrem zatvorenia appky)."
          }
        }
      }
    },
    "Your first change opens a change week (%@). Then the schedule stays for a month; unlocking it sooner costs %@ 🪙.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your first change opens a change week (%@). Then the schedule stays for a month; unlocking it sooner costs %@ 🪙."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prvá zmena otvorí týždeň na zmeny (%@). Potom rozvrh mesiac platí; skôr ho odomkneš za %@ 🪙."
          }
        }
      }
    },
    "Your next finished night repairs a ruin.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your next finished night repairs a ruin."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruinu opraví ďalšia hotová noc."
          }
        }
      }
    },
    "“Go to sleep” works from %@ before bedtime until %@ after it – in Strict mode until %@ after it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Go to sleep” works from %@ before bedtime until %@ after it – in Strict mode until %@ after it."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "„Ísť spať“ ide od %@ pred večierkou do %@ po nej – v prísnom režime do %@ po nej."
          }
        }
      }
    },
    "In Strict mode “Go to sleep” also closes sooner: %@ after bedtime instead of %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Strict mode “Go to sleep” also closes sooner: %@ after bedtime instead of %@."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V prísnom režime sa „Ísť spať“ zatvára skôr: %@ po večierke namiesto %@."
          }
        }
      }
