          "stringUnit": {
            "state": "translated",
            "value": "Polícia našla stratenú mačku – volá sa %@ a do spania je už doma 🐾"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Policie našla ztracenou kočku – jmenuje se %@ a do spaní je už doma 🐾"
          }
        }
      }
    },
    "The class has a cat called %@ – voted the best sleeper in the whole school 🏆": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The class has a cat called %@ – voted the best sleeper in the whole school 🏆"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Trieda má mačku – volá sa %@ a v spaní je najlepšia z celej školy 🏆"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Třída má kočku – jmenuje se %@ a ve spaní je nejlepší z celé školy 🏆"
          }
        }
      }
    },
    "The town hall has a new clerk: a cat called %@, who stamps papers with a paw 🐾": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The town hall has a new clerk: a cat called %@, who stamps papers with a paw 🐾"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na radnici majú novú úradníčku – mačku menom %@. Pečiatkuje labkou 🐾"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na radnici mají novou úřednici – kočku jménem %@. Razítkuje tlapkou 🐾"
          }
        }
      }
    },
    "A cat called %@ took the lift to the skyscraper's top floor – just for the view 🐈": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A cat called %@ took the lift to the skyscraper's top floor – just for the view 🐈"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mačka menom %@ sa vyviezla výťahom na najvyššie poschodie mrakodrapu – len kvôli výhľadu 🐈"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kočka jménem %@ se svezla výtahem do nejvyššího patra mrakodrapu – jen kvůli výhledu 🐈"
          }
        }
      }
    },
    "A cat called %@ visits a different doorstep every evening, just to say goodnight 🐈": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A cat called %@ visits a different doorstep every evening, just to say goodnight 🐈"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mačka menom %@ každý večer navštívi iný prah, len aby povedala dobrú noc 🐈"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kočka jménem %@ každý večer navštíví jiný práh, jen aby řekla dobrou noc 🐈"
          }
        }
      }
    },
    "Our newest building – %@ – already looks as if it had always been here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Our newest building – %@ – already looks as if it had always been here."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Najnovšia stavba v meste – %@ – už vyzerá, akoby tu stála odjakživa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejnovější stavba ve městě – %@ – už vypadá, jako by tu stála odjakživa."
          }
        }
      }
    },
    "The street lamps dim a little at bedtime, so the whole town knows it's time 🌙": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The street lamps dim a little at bedtime, so the whole town knows it's time 🌙"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouličné lampy sa pri večierke trochu stlmia, aby celé mesto vedelo, že je čas 🌙"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouliční lampy se při večerce trochu ztlumí, aby celé město vědělo, že je čas 🌙"
          }
        }
      }
    },
    "The milkman starts his round at dawn – so of course he goes to bed early 🥛": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The milkman starts his round at dawn – so of course he goes to bed early 🥛"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mliekar začína rozvoz za svitania – a tak, samozrejme, chodí spať zavčasu 🥛"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mlékař začíná rozvoz za svítání – a tak samozřejmě chodí spát brzy 🥛"
          }
        }
      }
    },
    "Someone in town snores a little. Nobody minds – it sounds like a tiny purr 😺": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone in town snores a little. Nobody minds – it sounds like a tiny purr 😺"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Niekto v meste trochu chrápe. Nikomu to neprekáža – znie to ako tiché priadenie 😺"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Někdo ve městě trochu chrápe. Nikomu to nevadí – zní to jako tiché předení 😺"
          }
        }
      }
    },
    "The bakers go to bed right after dinner – their day starts at three in the morning 🥐": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bakers go to bed right after dinner – their day starts at three in the morning 🥐"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pekári chodia spať hneď po večeri – ich deň sa začína o tretej ráno 🥐"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pekaři chodí spát hned po večeři – jejich den začíná ve tři ráno 🥐"
          }
        }
      }
    },
