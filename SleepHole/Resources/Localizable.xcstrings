    "A stove crackles, crickets outside; sawing, planing, sanding, nails, a broom, a purring cat. A different story every night.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A stove crackles, crickets outside; sawing, planing, sanding, nails, a broom, a purring cat. A different story every night."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Praská pec, vonku svrčky; píla, hoblík, brúsny papier, klince, metla a priadúca mačka. Každú noc iný príbeh."
          }
        }
      }
