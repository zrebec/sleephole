    "A calm hour: a whole hour between the end of the setup and the alarm with no trip out of the app, no phone use and no pause.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A calm hour: a whole hour between the end of the setup and the alarm with no trip out of the app, no phone use and no pause."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokojná hodina: celá hodina od konca prípravy do budíka bez odchodu z appky, bez použitia telefónu a bez pauzy."
          }
        }
      }
    },
    "A change saved in the evening, once tonight's building can start, applies from tomorrow.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A change saved in the evening, once tonight's building can start, applies from tomorrow."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmena uložená večer, keď sa už dá začať stavba, platí od zajtra."
          }
        }
      }
    },
    "A finished night pays %@–%@ 🪙, +%lld without a pause, +%lld for every calm hour. Your town gets residents and taller buildings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A finished night pays %@–%@ 🪙, +%lld without a pause, +%lld for every calm hour. Your town gets residents and taller buildings."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hotová noc %@–%@ 🪙, bez pauzy +%lld, každá pokojná hodina +%lld. V meste pribúdajú obyvatelia a vyššie budovy."
          }
        }
      }
    },
    "A finished night: %@ 🪙 (level 1), %@ (2), %@ (3), %@ (4). Unfinished: half.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A finished night: %@ 🪙 (level 1), %@ (2), %@ (3), %@ (4). Unfinished: half."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hotová noc: %@ 🪙 (úroveň 1), %@ (2), %@ (3), %@ (4). Rozostavaná: polovica."
          }
        }
      }
    },
    "A moment to get ready": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A moment to get ready"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Chvíľa na prípravu"
          }
        }
      }
    },
    "A night without a pause: +%lld 🪙.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A night without a pause: +%lld 🪙."
