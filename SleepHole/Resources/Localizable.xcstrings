          "stringUnit": {
            "state": "translated",
            "value": "Sweet things in moderation"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sladkosti s mierou"
          }
        }
      }
    },
    "Phone face down": {
