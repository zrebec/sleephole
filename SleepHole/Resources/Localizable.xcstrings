    "If you leave the app, you'll get a “Come back to SleepHole” alert.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you leave the app, you'll get a “Come back to SleepHole” alert."
          }
        },
