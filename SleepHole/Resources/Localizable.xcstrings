    "Every evening you start a building. Leave your phone alone at night and get up on time, and the building gets finished – your nights grow into a town.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every evening you start a building. Leave your phone alone at night and get up on time, and the building gets finished – your nights grow into a town."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý večer začneš stavať budovu. Keď v noci necháš telefón na pokoji a ráno vstaneš načas, budova sa dokončí – a z tvojich nocí rastie mesto."
          }
        }
      }
    },
    "Every night that builds something (complete or unfinished) moves you forward:": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every night that builds something (complete or unfinished) moves you forward:"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá noc, ktorá postaví budovu (hotovú či rozostavanú), ťa posunie ďalej:"
          }
        }
      }
    },
