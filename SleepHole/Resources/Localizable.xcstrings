    "Without notifications you won't get the “Come back” warning or the backup alarm. If you use a Focus (Sleep, Do Not Disturb), allow SleepHole in it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without notifications you won't get the “Come back” warning or the backup alarm. If you use a Focus (Sleep, Do Not Disturb), allow SleepHole in it."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez upozornení nepríde varovanie „Vráť sa“ ani záložný budík. Ak máš zapnuté Sústredenie (Spánok, Nerušiť), povoľ v ňom SleepHole."
          }
        }
      }
    },
    "Wrong code": {
      "localizations": {
