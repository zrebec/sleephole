      }
    },
    "Switch the screen off and the calm night goes on.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch the screen off and the calm night goes on."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zhasni obrazovku a pokojná noc pokračuje."
          }
        }
      }
    },
    "Without a passcode with Face ID or Touch ID, SleepHole can't tell locking the phone from leaving the app, so leaving isn't counted on this iPhone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without a passcode with Face ID or Touch ID, SleepHole can't tell locking the phone from leaving the app, so leaving isn't counted on this iPhone."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez kódu s Face ID alebo Touch ID SleepHole nevie rozlíšiť zamknutie telefónu od odchodu z appky, preto sa na tomto iPhone odchody nepočítajú."
          }
        }
      }
    },
    "A pause no longer fits – you can confirm getting up from %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A pause no longer fits – you can confirm getting up from %@."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauza sa už nezmestí – vstávanie potvrdíš od %@."
          }
        }
      }
    },
    "Test night (30 min, %llds setup)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test night (30 min, %llds setup)"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Testovacia noc (30 min, príprava %llds)"
          }
        }
      }
    },
    "Strict mode": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strict mode"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prísny režim"
          }
        }
      }
    },
    "Off: when you unlock the phone and keep using it at night, SleepHole only reminds you gently and the building stays. On: the phone rings a loud warning, and tonight's building comes down if you keep using it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off: when you unlock the phone and keep using it at night, SleepHole only reminds you gently and the building stays. On: the phone rings a loud warning, and tonight's building comes down if you keep using it."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypnutý: keď v noci telefón odomkneš a používaš ho, SleepHole ti to len jemne pripomenie a stavba zostáva. Zapnutý: telefón nahlas zazvoní a dnešná stavba spadne, ak ho používaš ďalej."
          }
        }
      }
    },
    "Switch the screen off within %lld seconds so tonight's building goes on 🏗️": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch the screen off within %lld seconds so tonight's building goes on 🏗️"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zhasni obrazovku do %lld sekúnd, nech dnešná stavba pokračuje 🏗️"
          }
        }
      }
    },
    "⚠️ Heads up! SleepHole was closed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Heads up! SleepHole was closed"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Pozor! SleepHole sa zavrela"
          }
        }
      }
    },
    "Open it within %lld seconds so tonight's building goes on 🏗️": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open it within %lld seconds so tonight's building goes on 🏗️"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvor ju do %lld sekúnd, nech dnešná stavba pokračuje 🏗️"
          }
        }
      }
    },
    "Apple Health": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Zdravie"
          }
        }
      }
    },
    "Show when you fell asleep": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show when you fell asleep"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukázať, kedy prišiel spánok"
          }
        }
      }
    },
    "Apple Health isn't available on this device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health isn't available on this device."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Zdravie na tomto zariadení nie je dostupné."
          }
        }
      }
    },
    "SleepHole reads your sleep from Apple Health (an Apple Watch or another sleep app writes it there) and shows when you really fell asleep next to when you went to bed. It only reads – nothing is written to Health and nothing leaves your iPhone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SleepHole reads your sleep from Apple Health (an Apple Watch or another sleep app writes it there) and shows when you really fell asleep next to when you went to bed. It only reads – nothing is written to Health and nothing leaves your iPhone."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "SleepHole číta tvoj spánok z appky Zdravie (zapisujú ho tam Apple Watch alebo iná appka na spánok) a ukáže, kedy naozaj prišiel spánok, vedľa začiatku noci. Iba číta – do Zdravia nič nezapisuje a nič neopúšťa tvoj iPhone."
          }
        }
      }
    },
    "Nights with sleep data: %lld of %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nights with sleep data: %lld of %lld"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Noci s údajmi o spánku: %1$lld z %2$lld"
          }
        }
      }
    },
    "No data yet? In the Health app open your profile → Apps → SleepHole and allow Sleep.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No data yet? In the Health app open your profile → Apps → SleepHole and allow Sleep."
          }
        },
        "sk": {
