        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Noc bez pauzy: +%lld 🪙."
          }
        }
      }
    },
    "A pause can start only if it ends before the morning confirmation opens.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A pause can start only if it ends before the morning confirmation opens."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauza sa dá začať, len ak skončí pred ranným potvrdením."
          }
        }
      }
    },
    "A phone call doesn't count – come back to the app after it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A phone call doesn't count – come back to the app after it."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonát sa nepočíta – po hovore sa vráť do appky."
          }
        }
      }
    },
    "A protected night neither breaks nor extends your streak; it gives no building and no coins.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A protected night neither breaks nor extends your streak; it gives no building and no coins."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Chránená noc sériu nepreruší ani nepredĺži; budova ani mince za ňu nie sú."
          }
        }
      }
    },
    "A Tibetan singing bowl, the strikes come closer together.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Tibetan singing bowl, the strikes come closer together."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tibetská spievajúca miska, údery sa postupne zhusťujú."
          }
        }
      }
    },
    "A backup can't be restored during a night.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A backup can't be restored during a night."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Počas stavby sa záloha nedá obnoviť."
