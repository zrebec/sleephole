    "Setup is shortened to 10s (5 min in the app). After it the building collapses if the app is in the background for more than 10s. Locking the phone is fine.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup is shortened to 10s (5 min in the app). After it the building collapses if the app is in the background for more than 10s. Locking the phone is fine."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Príprava je skrátená na 10s (v appke 5 min). Po nej sa stavba zrúti, ak je appka v pozadí dlhšie ako 10s. Zamknutie telefónu je v poriadku."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příprava je zkrácená na 10s (v appce 5 min). Po ní se stavba zřítí, pokud je appka na pozadí déle než 10s. Zamknutí telefonu je v pořádku."
          }
        }
      }
    },
