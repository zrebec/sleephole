        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulácia trvá, kým ju nevrátiš na Naživo alebo kým sa appka nespustí znova. Potrebuje mesto."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulace trvá, dokud ji nevrátíš na Naživo, nebo dokud se appka nespustí znovu. Potřebuje město."
          }
        }
      }
    },
    "A stove crackles, crickets outside; sawing, planing, sanding, nails, a broom, a purring cat. A different story every night.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A stove crackles, crickets outside; sawing, planing, sanding, nails, a broom, a purring cat. A different story every night."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Praská pec, vonku svrčky; píla, hoblík, brúsny papier, klince, metla a pradúca mačka. Každú noc iný príbeh."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V kamnech praská oheň, venku cvrčci; pila, hoblík, brusný papír, hřebíky, koště a předoucí kočka. Každou noc jiný příběh."
          }
        }
      }
    },
    "A town hall, school, fire station, police or hospital.": {
      "localizations": {
        "en": {
          "stringUnit": {
