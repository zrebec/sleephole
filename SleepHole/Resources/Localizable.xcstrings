    "Off: no system alarm in the morning – SleepHole's own alarm and the backup notifications still ring. In Strict mode the lock-screen warning still rings as a system alarm.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off: no system alarm in the morning – SleepHole's own alarm and the backup notifications still ring. In Strict mode the lock-screen warning still rings as a system alarm."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypnuté: ráno žiadny systémový budík – budík SleepHole a záložné upozornenia zazvonia aj tak. Varovanie prísneho režimu na zamknutej obrazovke zvoní ako systémový budík naďalej."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypnuto: ráno žádný systémový budík – budík SleepHole a záložní oznámení zazvoní i tak. Varování přísného režimu na zamčené obrazovce zvoní jako systémový budík dál."
          }
        }
      }
    },
    "Open notification settings": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open notification settings"
