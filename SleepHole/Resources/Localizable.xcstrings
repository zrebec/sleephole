        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obyvatelia si šepkajú: „Kto by hasil požiar? Hasičov ešte nemáme.“"
          }
        }
      }
    },
    "Overheard at the bakery: “If someone gets ill, where do we go? A hospital would be nice.”": {
      "localizations": {
