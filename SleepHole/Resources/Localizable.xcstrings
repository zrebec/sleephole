    "For %@ you can leave SleepHole. The first pause of a night is free – a night without any pause pays +%lld 🪙.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For %@ you can leave SleepHole. The first pause of a night is free – a night without any pause pays +%lld 🪙."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na %1$@ môžeš odísť zo SleepHole. Prvá pauza za noc je zadarmo – noc bez pauzy však dáva +%2$lld 🪙."
          }
        }
      }
    },
    "For %@ you can leave SleepHole. This pause costs %lld 🪙.": {
