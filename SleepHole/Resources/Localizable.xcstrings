    "A backup can't be restored during a night.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A backup can't be restored during a night."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Počas stavby sa záloha nedá obnoviť."
          }
        }
      }
    },
    "A complete night = %lld 🪙, unfinished = %lld 🪙, and every %lldth complete night in a row adds a +%lld 🪙 bonus. Soon you'll buy buildings with them: house %lld, L2 %lld, L3 %lld, L4 %lld 🪙.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A complete night = %lld 🪙, unfinished = %lld 🪙, and every %lldth complete night in a row adds a +%lld 🪙 bonus. Soon you'll buy buildings with them: house %lld, L2 %lld, L3 %lld, L4 %lld 🪙."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hotová noc = %1$lld 🪙, rozostavaná = %2$lld 🪙 a každá %3$lld. hotová noc v rade pridá bonus +%4$lld 🪙. Čoskoro si za ne budeš kupovať budovy: dom %5$lld, L2 %6$lld, L3 %7$lld, L4 %8$lld 🪙."
          }
        }
      }
    },
    "A nap can only start in this window, once a day. A complete nap earns %lld 🪙.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A nap can only start in this window, once a day. A complete nap earns %lld 🪙."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpočinok sa dá začať iba v tomto okne, raz za deň. Za hotový odpočinok dostaneš %lld 🪙."
          }
        }
      }
    },
    "A night is in progress.": {
      "localizations": {
        "en": {
