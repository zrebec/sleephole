        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauza sa už nezmestí – vstávanie potvrdíš od %@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauza se už nevejde – vstávání potvrdíš od %@."
          }
        }
      }
    },
