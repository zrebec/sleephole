    },
    "It costs %lld 🪙 – %lld 🪙 stay.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It costs %lld 🪙 – %lld 🪙 stay."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stojí %lld 🪙, ostane ti %lld 🪙."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stojí %lld 🪙, zbyde ti %lld 🪙."
          }
        }
      }
    },
    "A collection item is always a new one until you have the whole collection; after that a repeat turns into a quarter of the price in coins. A joker from a parcel lasts until the end of next month; a second one of the same kind also turns into a quarter of the price. Coins are earned only by sleeping – they can never be bought.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A collection item is always a new one until you have the whole collection; after that a repeat turns into a quarter of the price in coins. A joker from a parcel lasts until the end of next month; a second one of the same kind also turns into a quarter of the price. Coins are earned only by sleeping – they can never be bought."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vec do zbierky je vždy nová, kým nemáš celú zbierku; potom sa opakovaná vec zmení na štvrtinu ceny v minciach. Žolík z balíčka platí do konca budúceho mesiaca; druhý rovnaký sa tiež zmení na štvrtinu ceny. Mince sa dajú iba vyspať – kúpiť sa nedajú nikdy."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Věc do sbírky je vždy nová, dokud nemáš celou sbírku; potom se opakovaná věc změní na čtvrtinu ceny v mincích. Žolík z balíčku platí do konce příštího měsíce; druhý stejný se také změní na čtvrtinu ceny. Mince se dají jen naspat – koupit se nedají nikdy."
          }
        }
      }
    },
    "%@× the price": {
      "localizations": {
