    },
    "Your first change opens a change week (%@). Then the schedule stays for a month; unlocking it sooner costs %@ 🪙.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your first change opens a change week (%@). Then the schedule stays for a month; unlocking it sooner costs %@ 🪙."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prvá zmena otvorí týždeň na zmeny (%@). Potom rozvrh mesiac platí; skôr ho odomkneš za %@ 🪙."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "První změna otevře týden na změny (%@). Pak rozvrh platí celý měsíc; dřív ho odemkneš za %@ 🪙."
          }
        }
      }
    },
    "Your next finished night repairs a ruin.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your next finished night repairs a ruin."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruinu opraví ďalšia hotová noc."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruinu opraví další hotová noc."
          }
        }
      }
    },
    "“Go to sleep” works from %@ before bedtime until %@ after it – in Strict mode until %@ after it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Go to sleep” works from %@ before bedtime until %@ after it – in Strict mode until %@ after it."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "„Ísť spať“ ide od %@ pred večierkou do %@ po nej – v prísnom režime do %@ po nej."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„Jít spát“ jde nejdřív %@ před večerkou a nejpozději %@ po ní – v přísném režimu nejpozději %@ po ní."
          }
        }
      }
    },
    "In Strict mode “Go to sleep” also closes sooner: %@ after bedtime instead of %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Strict mode “Go to sleep” also closes sooner: %@ after bedtime instead of %@."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V prísnom režime sa „Ísť spať“ zatvára skôr: %@ po večierke namiesto %@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V přísném režimu se „Jít spát“ zavírá dřív: %@ po večerce místo %@."
          }
        }
      }
    },
    "A crackling camp fire, crickets and a brook; someone chops wood, the dog potters about, the chickens settle down, an owl calls. A different story every night.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A crackling camp fire, crickets and a brook; someone chops wood, the dog potters about, the chickens settle down, an owl calls. A different story every night."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Praská táborák, svrčky a potôčik; niekto štiepa drevo, pes sa motá okolo, sliepky sa ukladajú, zahúka sova. Každú noc iný príbeh."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Praská táborák, cvrčci a potůček; někdo štípe dřevo, pes se motá kolem, slepice jdou spát, zahouká sova. Každou noc jiný příběh."
          }
        }
      }
    },
    "A gentle kalimba melody.": {
