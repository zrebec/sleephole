          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Podpis appky SleepHole vyprší v čase uvedenom vyššie. Dovtedy pripoj iPhone k Macu a nainštaluj SleepHole znova – dáta zostanú. Deň a 3 hodiny vopred dostaneš pripomienku."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podpis appky SleepHole vyprší v termínu uvedeném výše. Do té doby připoj iPhone k Macu a nainstaluj SleepHole znovu – data zůstanou. Připomínku dostaneš den a 3 hodiny předem."
