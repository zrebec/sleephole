    },
    "The system alarm is a second backup next to the backup notifications: it rings in silent mode and during a Focus even if iOS has closed SleepHole – 30s after your wake time, or when SleepHole's own alarm stops after 2 minutes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system alarm is a second backup next to the backup notifications: it rings in silent mode and during a Focus even if iOS has closed SleepHole – 30s after your wake time, or when SleepHole's own alarm stops after 2 minutes."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Systémový budík je ďalšia záloha popri záložných upozorneniach: zvoní aj v tichom režime a počas Sústredenia, aj keď iOS appku SleepHole ukončil – 30s po budíčku, alebo keď po 2 minútach stíchne vlastný budík SleepHole."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Systémový budík je další záloha vedle záložních oznámení: zvoní i v tichém režimu a během Soustředění, i když iOS appku SleepHole ukončil – 30s po budíčku, nebo když po 2 minutách utichne vlastní budík SleepHole."
          }
        }
      }
    },
    "The temperature on Today comes from Apple Weather or, when that is not available, from MET Norway.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The temperature on Today comes from Apple Weather or, when that is not available, from MET Norway."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Teplota na obrazovke Dnes pochádza z Apple Weather, a keď nie je dostupné, z MET Norway."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Teplota na obrazovce Dnes pochází z Apple Weather, a když není k dispozici, z MET Norway."
          }
        }
      }
    },
