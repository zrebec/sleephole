        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Praská táborák, svrčky a potôčik; niekto štiepa drevo, pes sa motá okolo, sliepky sa ukladajú, zahúka sova. Každú noc iný príbeh."
          }
        }
      }
    },
