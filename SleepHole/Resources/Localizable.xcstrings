    },
    "3. The system alarm must ring – in silent mode and during a Focus too – with your alarm sound.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. The system alarm must ring – in silent mode and during a Focus too – with your alarm sound."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Systémový budík musí zazvoniť – aj v tichom režime a počas Sústredenia – tvojím zvukom budíka."
          }
        }
      }
    },
    "30 nights in a row": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "30 nights in a row"
          }
        },
        "sk": {
