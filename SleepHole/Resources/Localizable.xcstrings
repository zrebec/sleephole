    },
    "Going to bed and getting up at similar times, even on days off, teaches your body when it's time to sleep.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Going to bed and getting up at similar times, even on days off, teaches your body when it's time to sleep."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď chodíš spať a vstávaš v podobnom čase aj cez voľné dni, telo sa naučí, kedy je čas na spánok."
          }
        }
      }
    },
    "Weekends, gently": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekends, gently"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Víkend s mierou"
          }
        }
      }
    },
    "Try keeping weekend bedtimes within about an hour of your weeknight ones – your body clock will thank you.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try keeping weekend bedtimes within about an hour of your weeknight ones – your body clock will thank you."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skús, aby sa víkendové ukladanie do postele líšilo od všedných dní najviac o hodinu. Vnútorné hodiny sa potešia."
          }
        }
      }
    },
    "Screens off for an hour": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screens off for an hour"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrazovky preč na hodinu"
          }
        }
      }
    },
    "Phones, tablets and computers are best put away an hour before bed – their light can make falling asleep harder.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phones, tablets and computers are best put away an hour before bed – their light can make falling asleep harder."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mobil, tablet a počítač odlož hodinu pred spaním – ich svetlo môže sťažiť zaspávanie."
          }
        }
      }
    },
    "A calm bedtime routine": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A calm bedtime routine"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokojný večerný rituál"
          }
        }
      }
    },
    "Reading, soothing music or an audiobook, repeated each evening, tells your body that sleep is near.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading, soothing music or an audiobook, repeated each evening, tells your body that sleep is near."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čítanie, tichá hudba či audiokniha každý večer dajú telu vedieť, že spánok je blízko."
          }
        }
      }
    },
    "A warm bath": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A warm bath"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Teplý kúpeľ"
          }
        }
      }
    },
    "A warm bath 30 minutes to 2 hours before bed can help you relax into sleep.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A warm bath 30 minutes to 2 hours before bed can help you relax into sleep."
          }
        },
        "sk": {
