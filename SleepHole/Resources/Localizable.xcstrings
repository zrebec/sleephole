          "stringUnit": {
            "state": "translated",
            "value": "Napíš si starosti alebo zajtrajšie úlohy ešte pred spaním. Potom môžu počkať na papieri."
          }
        }
      }
    },
    "Try a relaxing trick": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try a relaxing trick"
          }
        },
        "sk": {
