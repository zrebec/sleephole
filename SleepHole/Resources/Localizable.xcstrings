            "state": "translated",
            "value": "Z mesiaca ostal len kúsok 🌘 Vychádza neskoro, ako poriadny spáč."
          }
        }
      }
    },
    "Overheard on the street: “This town gets nicer every night.”": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overheard on the street: “This town gets nicer every night.”"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Počuté na ulici: „To mesto je každou nocou krajšie.“"
          }
        }
      }
    },
    "The neighbours say the streets are quietest at night – just the way we like it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The neighbours say the streets are quietest at night – just the way we like it."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Susedia vravia, že v noci sú ulice najtichšie – presne ako to máme radi."
