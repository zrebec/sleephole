          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mimo bezplatného obdobia začne nová večierka alebo budíček tvoju 🔥 sériu (%1$@) odznova. Budovy, mince aj levely ostanú. Zmena zadarmo: od %2$@, vždy 1.–3. deň v mesiaci."
          }
