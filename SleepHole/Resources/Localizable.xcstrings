          "stringUnit": {
            "state": "translated",
            "value": "Podpis appky SleepHole po čase vyprší – vtedy pripoj iPhone k Macu a nainštaluj SleepHole znova. Dáta zostanú."
          }
        },
        "cs": {
          "stringUnit": {
