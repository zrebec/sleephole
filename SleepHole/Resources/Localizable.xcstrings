    "%lld or %lld minutes, between %@ and %@ (changeable), once a day. Complete +%lld 🪙, cut short +%lld 🪙. It builds nothing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld or %lld minutes, between %@ and %@ (changeable), once a day. Complete +%lld 🪙, cut short +%lld 🪙. It builds nothing."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld alebo %lld minút, v okne %@–%@ (dá sa zmeniť), raz za deň. Hotový +%lld 🪙, skrátený +%lld 🪙. Nestavia sa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld nebo %lld minut, v okně %@–%@ (dá se změnit), jednou denně. Hotový +%lld 🪙, zkrácený +%lld 🪙. Nic se nestaví."
          }
        }
      }
    },
