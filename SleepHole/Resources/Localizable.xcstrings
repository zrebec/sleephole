          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Koľko času máš po „Ísť spať“ na dokončenie toho, čo robíš – počíta sa od večierky. Po skoršom štarte je príprava vždy 15 min."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
