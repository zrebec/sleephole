        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Z našej najvyššej budovy vidno celé mesto."
          }
        }
      }
    },
    "The residents whisper: “Who would put out a fire? We have no fire station yet.”": {
      "localizations": {
        "en": {
