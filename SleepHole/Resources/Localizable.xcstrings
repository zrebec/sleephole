    "SleepHole's signature ends on %@. Connect your iPhone to the Mac and install SleepHole again – your town, nights and coins stay.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SleepHole's signature ends on %@. Connect your iPhone to the Mac and install SleepHole again – your town, nights and coins stay."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Podpis appky SleepHole sa končí %@. Pripoj iPhone k Macu a nainštaluj SleepHole znova – mesto, noci aj mince zostanú."
          }
        },
