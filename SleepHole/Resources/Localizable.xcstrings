    },
    "The SleepHole alarm also rings in Do Not Disturb or Sleep focus, and the “Come back” warning arrives there too. If iOS asks about time-sensitive notifications from SleepHole, keep them allowed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The SleepHole alarm also rings in Do Not Disturb or Sleep focus, and the “Come back” warning arrives there too. If iOS asks about time-sensitive notifications from SleepHole, keep them allowed."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Budík SleepHole zvoní aj v režime Nerušiť či Spánok a príde tam aj varovanie „Vráť sa“. Ak sa iOS spýta na časovo citlivé upozornenia od SleepHole, nechaj ich povolené."
          }
        }
      }
    },
    "The alarm rings even in silent mode. Pick the sound in Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The alarm rings even in silent mode. Pick the sound in Settings."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Budík zvoní aj v tichom režime. Zvuk si vyberieš v Nastaveniach."
          }
        }
      }
    },
    "The alarm rings for at most %@. Confirm you're up by shaking the phone or entering the code – at the earliest %@ before wake-up.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The alarm rings for at most %@. Confirm you're up by shaking the phone or entering the code – at the earliest %@ before wake-up."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Budík zvoní najviac %1$@. Vstávanie potvrdíš zatrasením telefónu alebo kódom – najskôr %2$@ pred budíčkom."
          }
        }
      }
    },
    "The app didn't run that night – nothing was built.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app didn't run that night – nothing was built."
