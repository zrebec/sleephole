    "The SleepHole alarm also rings in Do Not Disturb or Sleep focus, and the “SleepHole must stay open” warning arrives there too. If iOS asks about time-sensitive notifications from SleepHole, keep them allowed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The SleepHole alarm also rings in Do Not Disturb or Sleep focus, and the “SleepHole must stay open” warning arrives there too. If iOS asks about time-sensitive notifications from SleepHole, keep them allowed."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Budík SleepHole zvoní aj v režime Nerušiť či Spánok a príde tam aj varovanie „SleepHole musí zostať otvorená“. Ak sa iOS spýta na časovo citlivé upozornenia od SleepHole, nechaj ich povolené."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Budík SleepHole zvoní i v režimu Nerušit nebo Spánek a přijde tam i varování „SleepHole musí zůstat otevřený“. Pokud se iOS zeptá na časově citlivá oznámení od SleepHole, nech je povolená."
          }
        }
      }
    },
    "The alarm rings even in silent mode. Pick the sound in Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The alarm rings even in silent mode. Pick the sound in Settings."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Budík zvoní aj v tichom režime. Zvuk si vyberieš v Nastaveniach."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Budík zvoní i v tichém režimu. Zvuk si vybereš v Nastavení."
          }
        }
      }
    },
