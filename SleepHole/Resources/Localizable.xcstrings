    "Seven hours or more": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seven hours or more"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aspoň sedem hodín"
          }
        }
      }
    },
    "Most adults feel their best with at least 7 hours of sleep a night. Plan your evening backwards from the morning.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Most adults feel their best with at least 7 hours of sleep a night. Plan your evening backwards from the morning."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dospelým zvyčajne najlepšie vyhovuje 7 a viac hodín spánku. Naplánuj si večer od rána dozadu."
          }
        }
      }
    },
    "Make time for sleep": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make time for sleep"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Daj spánku čas"
          }
        }
      }
    },
    "Planning enough time for sleep helps protect your health and well-being – give it a spot in your day.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Planning enough time for sleep helps protect your health and well-being – give it a spot in your day."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čas na spánok pomáha chrániť zdravie a pohodu – daj mu pevné miesto vo svojom dni."
          }
        }
      }
    },
    "A warm evening drink": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A warm evening drink"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Teplý večerný nápoj"
          }
        }
      }
    },
    "Swap evening coffee or black tea for a warm milky drink or a herbal tea.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swap evening coffee or black tea for a warm milky drink or a herbal tea."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Večernú kávu či čierny čaj vymeň za teplé mlieko alebo bylinkový čaj."
          }
        }
      }
    },
    "A comfy bed": {
