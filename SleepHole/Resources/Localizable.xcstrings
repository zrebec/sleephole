        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Late coffee lingers"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Neskorá káva"
          }
        }
      }
    },
    "Caffeine can stay with you for up to 8 hours, so an afternoon coffee may still be awake at bedtime.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Caffeine can stay with you for up to 8 hours, so an afternoon coffee may still be awake at bedtime."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kofeín môže pôsobiť až 8 hodín, takže popoludňajšia káva môže byť hore ešte pri ukladaní do postele."
          }
        }
      }
    },
    "Heavy talks by daylight": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heavy talks by daylight"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťažké rozhovory cez deň"
          }
        }
      }
    },
    "Upsetting conversations are best kept for the daytime, so your evening stays calm.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upsetting conversations are best kept for the daytime, so your evening stays calm."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozrušujúce rozhovory si nechaj radšej na deň, nech je večer pokojný."
          }
        }
      }
    },
    "A light dinner": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A light dinner"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ľahká večera"
          }
        }
      }
    },
    "Make dinner your lightest meal and finish eating 3 to 4 hours before bed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make dinner your lightest meal and finish eating 3 to 4 hours before bed."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nech je večera najľahším jedlom dňa a dojedz 3 až 4 hodiny pred spaním."
          }
        }
      }
    },
    "Drink earlier": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drink earlier"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pi radšej skôr"
          }
        }
      }
    },
    "Try limiting liquids in the last few hours before sleep, and drink your fill earlier in the day.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try limiting liquids in the last few hours before sleep, and drink your fill earlier in the day."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pár hodín pred spaním pi menej a svoj pitný režim si splň radšej skôr cez deň."
          }
        }
      }
    },
    "A cool bedroom": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A cool bedroom"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Chladnejšia spálňa"
          }
        }
      }
    },
    "A cool room is cosy for sleeping – aim for around 18–20 °C (65–68 °F).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A cool room is cosy for sleeping – aim for around 18–20 °C (65–68 °F)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V chladnejšej izbe sa spí príjemne – skús približne 18 – 20 °C."
          }
        }
      }
    },
    "Make it dark": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make it dark"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nech je tma"
          }
        }
      }
    },
    "Blackout curtains or an eye mask keep the light off your eyes while you sleep.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blackout curtains or an eye mask keep the light off your eyes while you sleep."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatemňovacie závesy alebo maska na oči udržia svetlo mimo, kým spíš."
          }
        }
      }
    },
    "Quiet or softly noisy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet or softly noisy"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokoj v izbe"
          }
        }
      }
    },
    "Soft earplugs help with noise, and gentle sounds like rain can make the room cosy.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft earplugs help with noise, and gentle sounds like rain can make the room cosy."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mäkké štuple do uší zmiernia hluk a jemné zvuky ako dážď spravia izbu útulnejšou."
          }
        }
      }
    },
    "Bed is for sleep": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bed is for sleep"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Posteľ je na spanie"
          }
        }
      }
    },
    "Try using your bed just for sleep – no eating or working in it – so it says “sleep” to your brain.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try using your bed just for sleep – no eating or working in it – so it says “sleep” to your brain."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skús používať posteľ len na spanie – bez jedenia a práce – nech mozgu hovorí „spánok“."
          }
        }
      }
    },
    "Turn the clock away": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn the clock away"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodiny otoč bokom"
          }
        }
      }
    },
    "Turn clocks away from the bed – not seeing the minutes tick by is one less thing to think about.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn clocks away from the bed – not seeing the minutes tick by is one less thing to think about."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otoč hodiny od postele – ak nevidíš ubiehať minúty, máš o jednu starosť menej."
          }
        }
      }
    },
    "Every bit of movement": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every bit of movement"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aj trocha pohybu pomôže"
          }
        }
      }
    },
    "Even a little regular activity can help your sleep, and you can build it up gradually.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even a little regular activity can help your sleep, and you can build it up gradually."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Už trochu pravidelného pohybu môže pomôcť spánku a môžeš ho pomaly pridávať."
          }
        }
      }
    },
    "Exercise earlier": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exercise earlier"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cvič skôr počas dňa"
          }
        }
      }
    },
    "Try to finish exercising at least 3 hours before your planned bedtime.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try to finish exercising at least 3 hours before your planned bedtime."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skús dokončiť cvičenie aspoň 3 hodiny pred plánovaným spaním."
          }
        }
      }
    },
    "Catch some daylight": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Catch some daylight"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ranné svetlo"
          }
        }
      }
    },
    "About 30 minutes outside early in the day helps – even a cloudy sky beats dim indoor light.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About 30 minutes outside early in the day helps – even a cloudy sky beats dim indoor light."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Asi 30 minút vonku v prvých hodinách dňa pomôže – aj zamračená obloha je lepšia než slabé svetlo v interiéri."
          }
        }
      }
    },
